# --- App ---
# Web only: orchestrator/agents use their own PORT keys (below) so one shared
# .env can never send every service to the same port.
PORT=3000
# ORCHESTRATOR_PORT=8000
# AGENT_DESTINATION_PORT=8001
# AGENT_WEATHER_PORT=8002
# AGENT_BUDGET_PORT=8003
# AGENT_HR_PORT=8004
# Overall plan budget (outer safety net; per-stage deadlines are smaller):
# PLAN_TIMEOUT_MS=300000
ALLOWED_ORIGINS=http://localhost:3000

# --- Agent registry ---
AGENTS_REGISTRY_PATH=./config/agents.json
# Compose injects these to retarget agents on the docker network (§3.2):
# AGENT_DESTINATION_RESEARCH_BASE_URL=http://agent-destination:8001
# AGENT_WEATHER_BASE_URL=http://agent-weather:8002
# AGENT_BUDGET_BASE_URL=http://agent-budget:8003
# AGENT_HR_BASE_URL=http://agent-hr:8004
ORCHESTRATOR_URL=http://localhost:8000

# --- Budget cost catalog (§17.4) ---
# The budget agent seeds this read-only SQLite file at startup (and on demand via
# `npm run db:seed`). Relative paths resolve from the repo root. Values are USD;
# `fx` converts them to local units.
# COST_DB_PATH=./data/costs.db

# --- HR employee database (§17.5) ---
# Synthetic leave balances, seeded read-only at startup (and by `npm run db:seed`).
# The plan only calls this agent when the UI's "Connect to HR portal" toggle sets
# `requestHrValidation` and supplies a mandatory employee id (`E0001` format).
# Relative paths resolve from the repo root.
# HR_DB_PATH=./data/hr.db

# --- Weather providers (§6.2 / §17.3) ---
# Comma-separated fallback chain; first provider that answers wins.
# Available: open-meteo (default, geocoding + 16-day forecast), openweather
# (needs OPENWEATHER_API_KEY), tomorrow (needs TOMORROW_API_KEY), wttr.
# Providers whose key is missing are skipped with a disclaimer (§17.3) — the
# section still answers; if none is runnable, open-meteo,wttr take over.
WEATHER_PROVIDERS=open-meteo,openweather,tomorrow,wttr
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
# OPENWEATHER_API_KEY=
# OPENWEATHER_BASE_URL=https://api.openweathermap.org
# TOMORROW_API_KEY=
# TOMORROW_BASE_URL=https://api.tomorrow.io

# --- Destination research sources (§6.2 / §17.2) ---
# Comma-separated fallback order for the deterministic pre-fetch and the
# research tools. Available: wikivoyage, wikipedia. Unknown names fail fast.
KNOWLEDGE_PROVIDERS=wikivoyage,wikipedia

# --- Model layer (§6.1) ---
# ollama (local default) | groq | openai | anthropic | gemini | mock (offline/dev)
# The UI header can override this per plan at runtime — no restart needed.
MODEL_PROVIDER=ollama
MODEL_MODEL=qwen3:8b
# Tried in order on failure: slow local → fast cloud → mock (offline dev).
MODEL_FALLBACK_CHAIN=ollama,groq,mock
# Per-call deadline: a slow provider fails fast into the fallback chain.
# Raise this on CPU-bound local models (e.g. 180000 for qwen3:8b on a laptop):
# MODEL_TIMEOUT_MS=60000
# Max tool-execution rounds per model call before a tool-free final answer (§6.1):
# MODEL_TOOL_ROUNDS=3
# Per-role overrides:
# MODEL_INTENT_PROVIDER=ollama
# MODEL_INTENT_MODEL=llama3.1:8b
# MODEL_RESEARCH_PROVIDER=openai
# MODEL_RESEARCH_MODEL=gpt-4o-mini
# MODEL_SYNTHESIS_PROVIDER=anthropic
# MODEL_SYNTHESIS_MODEL=claude-sonnet-4

# --- Local models ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Cloud keys (only needed when selected above) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Groq (OpenAI-compatible). With a key set, its live model list appears in the
# UI selector and any listed model can be chosen per plan at runtime:
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b

# --- Persistence (§10): memory (default, skeleton) | prisma (future DB phase) ---
PLAN_STORE=memory
# DATABASE_URL=file:./data/dev.db

# --- Security ---
INTERNAL_A2A_CREDENTIAL=
